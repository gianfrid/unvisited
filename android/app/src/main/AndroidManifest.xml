    <manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">
    <!-- OSM map tiles are the app's only network use. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Device location: only used after the user taps the locate button
         (the runtime prompt); the map also silently refines to a live fix
         when permission is already granted. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Active recording: geolocator's foreground service carries the
         session (its merged declaration is verified on-device at target
         API 34+ per SPEC's manual checklist). The notification is
         mandatory under promotion; the session starts only from the
         Record button, so while-in-use location suffices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <application
        android:label="unvisited"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share intents: OpenTracks / file managers send single tracks.
                 Detection is content-based on the Dart side, so accepting a
                 slightly wider mime set is safer than missing an export. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/vnd.google-earth.kmz"/>
                <data android:mimeType="application/vnd.google-earth.kml+xml"/>
                <data android:mimeType="application/vnd.garmin.fit"/>
                <data android:mimeType="application/fit"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="text/xml"/>
            </intent-filter>
        </activity>
        <!-- Flutter 3.27+ defaults to the Impeller renderer; on devices where
             its textures fail to present, the map tiles never appear (grey
             map while vector layers paint). Skia is the battle-tested
             path for a map-heavy app - opt out until Impeller is stable on
             tested devices; revert by removing this meta-data. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
