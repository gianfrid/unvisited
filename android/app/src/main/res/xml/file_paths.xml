<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider scopes for track export: the app-private storage root
     ({@code getFilesDir()}/unvisited) holds the tracks/ directory. Only
     granted URIs leave the app; the provider never serves anything outside
     this subtree. -->
<paths>
    <files-path name="storage_root" path="." />
</paths>
